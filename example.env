# Server Configuration
# Hostname for the server (used for cookie domain)
SERVER_HOSTNAME=localhost

# Port for the server to listen on
SERVER_PORT=8080

# Database Configuration
# SQLite database file path (relative or absolute)
DATABASE_URL=./data/forum.db

# Security Configuration
# Secret key for JWT token signing (change this to a random string in production)
JWT_SECRET=your-secret-key-change-this-in-production

# Debug Mode
# Set to "true" for development, "false" for production
DEBUG=false

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Leave empty to disable CORS or set specific origins
CORS_ALLOWED_ORIGINS=

# Logging Configuration
# Log level: DEBUG, INFO, WARN, ERROR (ignored when DEBUG=true)
LOG_LEVEL=INFO
